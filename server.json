{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.LiuXiyun/smartoken-mcp",
  "title": "SmarToken",
  "description": "Discover models and make text chat calls through the SmarToken API.",
  "version": "0.1.2",
  "websiteUrl": "https://thesmartoken.com/register?utm_source=mcp_registry&utm_medium=directory&utm_campaign=smartoken_mcp",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "smartoken-mcp",
      "version": "0.1.2",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "SMTOKEN_API_KEY",
          "description": "Your SmarToken API key; required for billable chat calls.",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/LiuXiyun/smartoken-mcp",
    "source": "github"
  }
}
